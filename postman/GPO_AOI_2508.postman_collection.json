  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "attackId",
      "value": "1"
    },
    {
      "key": "diaryDate",
      "value": "2026-09-23"

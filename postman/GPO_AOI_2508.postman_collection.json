                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Forecast status and metadata', () => {",
                  "  pm.expect(['ready', 'insufficient_data']).to.include(body.status);",
                  "  pm.expect(body.calculated_at).to.match(/Z$/);",
                  "  pm.expect(body.prediction_date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                  "  pm.expect(body.time_zone).to.be.a('string');",
                  "  pm.expect(body.horizon_days).to.eql(1);",
                  "});",
                  "pm.test('Probability follows status', () => {",
                  "  if (body.status === 'ready') {",
                  "    pm.expect(body.probability).to.be.a('number').and.within(0, 1);",
                  "    pm.expect(body.risk_level).to.be.a('string');",
                  "    pm.expect(body.missing_fields).to.eql([]);",
                  "  } else {",
                  "    pm.expect(body.probability).to.eql(null);",
                  "    pm.expect(body.risk_level).to.eql(null);",
                  "    pm.expect(body.missing_fields.length).to.be.above(0);",
                  "  }",
                  "});",
                  "pm.test('Missing caffeine has no probability', () => {",
                  "  pm.expect(body.status).to.eql('insufficient_data');",
                  "  pm.expect(body.missing_fields).to.eql(['caffeine_intake']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/forecast/risk"
          }
        }
      ]
